{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GamePilot",
  "version": "0.0.1",
  "identifier": "com.gamepilot.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:30110",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:sidecar && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "GamePilot",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/gamepilot-engine"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
