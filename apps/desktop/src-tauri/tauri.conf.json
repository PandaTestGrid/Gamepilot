{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GamePilot",
  "version": "0.1.0",
  "identifier": "com.gamepilot.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:30110",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:sidecar && pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2M0IzQUU3QkU5QzE5QzAKUldUQUdaeSs1em83RmpZVkkxVG9XaFBpYnk0Vy9FR2JRMUo3cW9pZjIvSG93UXhHTG1BVVhoeFYK",
      "endpoints": [
        "https://github.com/PandaTestGrid/Gamepilot/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/gamepilot-engine"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/header.bmp",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "icons/installer/header.bmp",
        "sidebarImage": "icons/installer/sidebar.bmp",
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      },
      "wix": {
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      }
    }
  }
}
